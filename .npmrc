# npm 12 menolak dependensi berbentuk URL ("remote") secara bawaan
# (error EALLOWREMOTE). Paket xlsx proyek ini diambil dari CDN resmi
# SheetJS (build 0.20.3 yang sudah menambal GHSA-4r6h-8v6p-xvw6 dan
# GHSA-5pgg-2g8v-p4x9), jadi izinkan fetch remote hanya untuk
# dependensi yang dinyatakan langsung oleh package.json proyek ini.
allow-remote=root
