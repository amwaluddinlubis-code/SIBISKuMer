// ---------------- Firestore rules: Sinkron Cloud SIBISKuMer ----------------
// Cara pakai (sekali saja, gratis):
//   npm i -g firebase-tools && firebase login
//   firebase init firestore   (pilih project sesuai firebase-applet-config.json)
//   ganti firestore.rules dengan file ini, lalu:
//   firebase deploy --only firestore:rules
//
// Model: hanya pengguna LOGIN Google yang boleh baca/tulis rumah cloud
// `cloud/{kunciSekolah}/...`. Isolasi antar-sekolah = kunci (NPSN/dbName) +
// PIN sekolah yang diverifikasi sisi klien (bukan penegakan server —
// jangan taruh data sangat sensitif; password sudah berupa hash).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cloud/{sekolah}/{coll}/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cloud/{sekolah}/meta/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cloud/{sekolah} {
      allow read, write: if request.auth != null;
    }
    // Tolak semua path lain secara eksplisit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
